# ============================================================================
# GTSDB Cloud — Firebase configuration
# ----------------------------------------------------------------------------
# This app uses Firebase Authentication (Email + Google sign-in).
# Get your web app config from: Firebase Console -> Project settings -> General
#   -> "Your apps" -> Web app -> SDK setup and configuration.
#
# NEXT_PUBLIC_* variables are safe to commit to a public repo (Firebase web
# config is public by design). If any variable is missing or still a
# placeholder, the app falls back to a local "Demo mode" so you can try the
# whole platform without configuring Firebase.
#
# Your Firebase project number is 628700320308 (the numeric ID).
# ============================================================================

# Required for real authentication
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gtsdb-cloud.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gtsdb-cloud
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gtsdb-cloud.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ----------------------------------------------------------------------------
# Optional — only needed if you deploy the platform API to a serverless host
# (e.g. Vercel) and want instances to persist across cold starts. When unset
# the API uses a local JSON file store (./data/platform.json), which works
# great for local / single-instance deployments.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgres://...
# STORE_KIND=file

# ----------------------------------------------------------------------------
# Shared managed GTSDB server (multi-tenant). The platform provisions each
# instance as an isolated tenant namespace (a GTSDB user) on this server via
# `adduser`/`resetkey`, using the root token.
# ----------------------------------------------------------------------------
# GTSDB_ADMIN_TOKEN=                     # root token of the shared GTSDB server (required for real provisioning)
# GTSDB_BASE_URL=http://localhost:5556   # internal address the platform proxies to
# GTSDB_PUBLIC_HTTP_URL=https://gtsdb-http-5556.abby.md   # public HTTPS endpoint for clients
# GTSDB_PUBLIC_TCP_URL=tcp://gtsdb-tcp-5555.abby.md:5555  # public TCP endpoint for clients

# ----------------------------------------------------------------------------
# Platform admin (optional). Comma-separated emails that can access
# /dashboard/admin to manage members and instances.
# ----------------------------------------------------------------------------
# ADMIN_EMAILS=you@example.com             # server-side authorization (never expose this)
# NEXT_PUBLIC_ADMIN_EMAILS=you@example.com # client-side: shows the Admin nav entry & page

# ----------------------------------------------------------------------------
# Stripe billing (optional). When STRIPE_SECRET_KEY is set, the billing page
# switches from the demo flow to real Stripe Checkout.
#
# Get the test keys from: Stripe Dashboard -> Developers -> API keys
#   STRIPE_SECRET_KEY=sk_test_...               (server-only, NEVER expose this)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Webhook signing secret from: Stripe Dashboard -> Developers -> Webhooks
# (endpoint: https://your-domain/api/billing/webhook, event: checkout.session.completed)
#   STRIPE_WEBHOOK_SECRET=whsec_...
#
# Recurring Price IDs from: Stripe Dashboard -> Products (one Product per paid
# plan, set billing period to "Monthly / Recurring"):
#   STRIPE_PRICE_PRO=price_...
#   STRIPE_PRICE_TEAM=price_...
# ----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=

