{
  "name": "gtsdb-cloud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gtsdb:build": "cd .. && go build -o cloud/bin/gtsdb-dev.exe .",
    "gtsdb:stop": "taskkill /IM gtsdb-dev.exe /F /T",
    "dev": "npm run gtsdb:build && node server.js --dev",
    "build": "next build",
    "start": "npm run gtsdb:build && next build && node server.js",
    "deploy": "(winpm2 stop ecosystem.config.json >nul 2>nul && echo [deploy] stopped || echo [deploy] nothing to stop) && npm run gtsdb:build && npm run build && winpm2 start ecosystem.config.json",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "firebase": "^11.0.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "sharp": "^0.35.3",
    "sonner": "^1.7.4",
    "stripe": "^22.4.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
